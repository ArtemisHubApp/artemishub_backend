# Copie para .env e preencha. Nunca commite o .env.
# Usuário e banco iguais aos do `docker run` do README; <senha> é a mesma POSTGRES_PASSWORD dele.
DATABASE_URL=postgresql+asyncpg://artemis:<senha>@localhost:5432/artemis
# Segredo do JWT, com pelo menos 32 bytes. Fica vazio de propósito: gere o seu e nunca o compartilhe.
# Linux e macOS: openssl rand -base64 48
# Qualquer sistema (inclusive Windows): python -c "import secrets; print(secrets.token_urlsafe(48))"
ARTEMIS_JWT_SEGREDO=
# Base do serviço de agentes (a API chama <base>/v1/responder).
ARTEMIS_AGENTS_URL=http://localhost:8001
# Token de serviço dos agentes: peça à equipe de agentes e deixe só no seu .env.
ARTEMIS_AGENTS_TOKEN=
# Endereço que aparece no navegador: esquema://host[:porta], sem caminho nem barra no fim.
# https sempre, exceto em localhost e 127.0.0.1 (o Vite, em desenvolvimento).
ARTEMIS_ORIGEM=http://localhost:5173
# Cookie só por HTTPS: true (padrão) ou false. false só com ARTEMIS_ORIGEM em http local.
ARTEMIS_COOKIE_SEGURO=false
